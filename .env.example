# Copy to .env and fill in. Never commit the real .env.

# Local development only. In Docker the database lives on a volume and the
# container sets DATABASE_URL=file:/app/data/payload.db itself.
DATABASE_URL=file:./payload.db

# Long random string. Changing it invalidates every admin session.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public origin, no trailing slash. Used for canonicals, hreflang, sitemap and
# JSON-LD, and baked into the client bundle at build time — rebuild the Docker
# image if this changes.
NEXT_PUBLIC_SERVER_URL=https://dourowonders.com

# ByteForms transactional email (server-side only — never expose to the browser)
BYTEFORMS_API_URL=
BYTEFORMS_API_KEY=

# Host port for docker compose (optional, defaults to 3000)
PORT=3000
